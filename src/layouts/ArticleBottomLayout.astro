---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { getAllWritingItems, getEnglishPreferredItems } from "@lib/blog";

type Props = {
  entry: CollectionEntry<"blog">;
  posts?: CollectionEntry<"blog">[];
};

// Get the requested entry
const { entry, posts: suppliedPosts } = Astro.props;
const { Content } = await render(entry);

// Get the next and prev entries (modulo to wrap index)
const posts = suppliedPosts ?? await getCollection("blog");
const items = entry.data.lang === "en"
  ? getEnglishPreferredItems(posts)
  : getAllWritingItems(posts);
const index = items.findIndex((item) => item.display.id === entry.id || item.source.id === entry.id);
const prev = items[(index - 1 + items.length) % items.length];
const next = items[(index + 1) % items.length];
---

<div>
  <article data-analytics-article data-analytics-region="article_body">
    <Content />
  </article>

  <div class="border-t border-black/10 py-8 dark:border-white/15" data-analytics-region="article_comments">
    <div id="comments">
      <p id="comments-status" class="text-sm text-black/60 dark:text-white/60" role="status">
        Loading comments…
      </p>
    </div>
  </div>

  <script>
    function initializeComments() {
      const comments = document.getElementById("comments")

      if (!comments || comments.dataset.ready === "true") return

      comments.dataset.ready = "true"

      const script = document.createElement("script")
      script.src = "https://giscus.app/client.js"
      script.async = true
      script.crossOrigin = "anonymous"
      script.dataset.repo = "YieumYoon/YieumYoon.github.io"
      script.dataset.repoId = "R_kgDOMFPW6g"
      script.dataset.category = "Announcements"
      script.dataset.categoryId = "DIC_kwDOMFPW6s4Cf82h"
      script.dataset.mapping = "pathname"
      script.dataset.strict = "0"
      script.dataset.reactionsEnabled = "1"
      script.dataset.emitMetadata = "0"
      script.dataset.inputPosition = "top"
      script.dataset.theme = document.documentElement.classList.contains("dark")
        ? "noborder_dark"
        : "noborder_light"
      script.dataset.lang = "en"
      script.dataset.loading = "lazy"
      script.addEventListener("load", () => {
        comments.querySelector("#comments-status")?.remove()
      })
      script.addEventListener("error", () => {
        const status = comments.querySelector("#comments-status")
        if (status) status.textContent = "Comments could not be loaded."
      })

      comments.appendChild(script)
    }

    document.addEventListener("astro:after-swap", initializeComments)
    initializeComments()
  </script>

  <div class="grid grid-cols-1 gap-6 border-t border-black/10 pt-8 dark:border-white/15 sm:grid-cols-2" data-analytics-region="article_navigation">
    <a
      href={prev.path}
      data-analytics-event="article_navigation"
      data-analytics-id={prev.source.data.slug ?? prev.source.id}
      data-analytics-value="previous"
      class="group block"
    >
      <div class="space-y-2">
        <div class="text-sm uppercase text-black/45 dark:text-white/45">Previous</div>
        <div class="font-semibold text-black dark:text-white group-hover:underline group-hover:decoration-[.5px] group-hover:underline-offset-4">
          {prev.display.data.title}
        </div>
      </div>
    </a>
    <a
      href={next.path}
      data-analytics-event="article_navigation"
      data-analytics-id={next.source.data.slug ?? next.source.id}
      data-analytics-value="next"
      class="group block sm:text-right"
    >
      <div class="space-y-2">
        <div class="text-sm uppercase text-black/45 dark:text-white/45">Next</div>
        <div class="font-semibold text-black dark:text-white group-hover:underline group-hover:decoration-[.5px] group-hover:underline-offset-4">
          {next.display.data.title}
        </div>
      </div>
    </a>
  </div>
</div>
