---
import { type CollectionEntry, getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import ArticleTopLayout from "@layouts/ArticleTopLayout.astro"
import ArticleBottomLayout from "@layouts/ArticleBottomLayout.astro"
import {
  getPostAlternates,
  getPostPath,
  getSourceSlug,
  isPublished,
  validateBlogPosts,
} from "@lib/blog"

// Create the static blog pages
export async function getStaticPaths() {
	const posts = await getCollection("blog")
	validateBlogPosts(posts)

	return posts.filter(isPublished).map((post) => ({
		params: { slug: getPostPath(post).replace(/^\/blog\//, "").replace(/\/$/, "") },
		props: post,
	}))
}

// Get the requested post
type Props = CollectionEntry<"blog">
const post = Astro.props
const { title, summary, image, tags } = post.data
const posts = await getCollection("blog")
validateBlogPosts(posts)
const contentId = getSourceSlug(post)
const alternates = getPostAlternates(post, posts)
---

<PageLayout
  title={title}
  description={summary}
  image={image}
  type="article"
  pageType="article"
  contentId={contentId}
  contentTags={tags}
  contentLanguage={post.data.lang}
  lang={post.data.lang}
  alternates={alternates}
>
  <TopLayout size="md">
    <div class="animate">
      <ArticleTopLayout entry={post} posts={posts}/>
    </div>
  </TopLayout>
  <BottomLayout size="md">
    <div class="animate">
      <ArticleBottomLayout entry={post} posts={posts} />
    </div>
  </BottomLayout>
</PageLayout>
