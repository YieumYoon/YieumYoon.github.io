---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import ArrowCard from "@components/ArrowCard.astro"
import WritingViewTabs from "@components/WritingViewTabs.astro"
import { getEnglishPreferredItems, validateBlogPosts } from "@lib/blog"

const posts = await getCollection("blog")
validateBlogPosts(posts)
const items = getEnglishPreferredItems(posts)
---

<PageLayout
  title="English writing"
  description="English translations when available, with untranslated posts shown in their original Korean."
  pageType="blog_index"
  lang="en"
>
  <TopLayout>
    <div class="animate page-heading">
      Writing
    </div>
  </TopLayout>
  <BottomLayout>
    <div class="animate" data-analytics-region="blog_index">
      <div class="flex flex-col">
        <WritingViewTabs active="english" />
        <p class="max-w-2xl pt-5 text-sm leading-6 text-black/60 dark:text-white/60">
          English translations are shown when available. Untranslated posts remain in Korean.
        </p>
        <div class="pt-3 text-sm text-black/50 dark:text-white/50">
          {items.length} posts
        </div>
        <ul class="divide-y divide-black/10 dark:divide-white/15">
          {items.map((item, index) => (
            <li>
              <ArrowCard item={item} position={index + 1} showStatus />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </BottomLayout>
</PageLayout>
