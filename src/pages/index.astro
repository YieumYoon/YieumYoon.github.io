---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import ArrowCard from "@components/ArrowCard.astro"
import { SITE, SOCIALS } from "@consts"
import { getEnglishPreferredItems, validateBlogPosts } from "@lib/blog"

const posts = await getCollection("blog")
validateBlogPosts(posts)
const items = getEnglishPreferredItems(posts).slice(0, 8)
---

<PageLayout title="Home" description={SITE.DESCRIPTION} pageType="home">
  <div class="relative bg-white dark:bg-black">
    <div class="mx-auto max-w-screen-lg px-5 pt-28 pb-16 space-y-20">

      <section class="animate" data-analytics-region="home_intro">
        <div class="space-y-5">
          <p class="text-sm text-black/50 dark:text-white/50">
            A developer who loves books
          </p>
          <h1 class="text-3xl font-semibold text-black dark:text-white">
            Yieum's development blog
          </h1>
          <div class="space-y-4 text-base leading-7 text-black/70 dark:text-white/70">
            <p>
              I am an undergraduate developer who moved from mechanical engineering to computer science.
            </p>
            <p>
              Hi, I'm Yieum. I like making things and understanding the process behind them. I started this blog to document how I learn, build, and grow from a beginner's point of view.
            </p>
            <p>
              I am comfortable reading, writing, and studying in English. I enjoy finding my own questions, working through them, and applying unfamiliar tools and ideas.
            </p>
            <p>
              Computer science appealed to me because it lets me test ideas and turn them into working products quickly. I care about software, but I am equally interested in problem solving, design, and user experience.
            </p>
            <p>
              This is where I keep notes on software, robotics, books, and the things I am learning to build.
            </p>
          </div>
        </div>
      </section>

      <section class="animate" data-analytics-region="home_latest_writing">
        <div class="space-y-2">
          <div class="flex items-center justify-between gap-4">
            <p class="font-semibold text-black dark:text-white">
              Latest writing
            </p>
            <a href="/blog/english/" class="group w-fit text-sm underline decoration-[.5px] decoration-black/25 dark:decoration-white/50 hover:decoration-black dark:hover:decoration-white text-black dark:text-white underline-offset-2 blend">
              <span class="text-black/75 dark:text-white/75 group-hover:text-black group-hover:dark:text-white blend">
                English view
              </span>
            </a>
          </div>
          <p class="text-sm leading-6 text-black/50 dark:text-white/50">
            English translations are shown when available. Other posts remain in Korean.
          </p>
          <ul class="divide-y divide-black/10 dark:divide-white/15">
            {items.map((item, index) => (
              <li>
                <ArrowCard item={item} position={index + 1} showStatus />
              </li>
            ))}
          </ul>
          <a href="/blog/" class="inline-block text-sm underline decoration-[.5px] underline-offset-2 text-black/65 hover:text-black dark:text-white/65 dark:hover:text-white">
            Browse all originals
          </a>
        </div>
      </section>

      <section class="animate" data-analytics-region="home_elsewhere">
        <div class="space-y-3">
          <p class="font-semibold text-black dark:text-white">
            Elsewhere
          </p>
          <p class="text-black/70 dark:text-white/70">
            You can find me here.
          </p>
          <div class="grid grid-cols-4 gap-y-2 mt-4 auto-cols-min">
            {SOCIALS.map(social => (
              <>
                <div class="col-span-1 flex items-center gap-1">
                  <span class="whitespace-nowrap truncate">
                    {social.NAME}
                  </span>
                </div>
                <div class="col-span-3 truncate">
                  <a
                    href={social.HREF}
                    target="_blank"
                    rel="noopener"
                    data-analytics-event={social.HREF.startsWith("mailto:") ? "contact_click" : "social_click"}
                    data-analytics-id={social.NAME.toLowerCase()}
                    class="group w-fit col-span-3 underline decoration-[.5px] decoration-black/25 dark:decoration-white/50 hover:decoration-black dark:hover:decoration-white text-black dark:text-white underline-offset-2 blend"
                  >
                    <span class="text-black/75 dark:text-white/75 group-hover:text-black group-hover:dark:text-white blend">
                      {social.TEXT}
                    </span>
                  </a>
                </div>
              </>
            ))}
          </div>
        </div>
      </section>
    </div>
  </div>
</PageLayout>
