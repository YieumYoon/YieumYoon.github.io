---
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import { SITE } from "@consts"
---

<PageLayout
  title="Page not found"
  description={`The requested page could not be found on ${SITE.TITLE}.`}
  pageType="not_found"
>
  <TopLayout>
    <div class="animate page-heading">404</div>
  </TopLayout>
  <BottomLayout>
    <section class="animate space-y-5">
      <h1 class="text-2xl font-semibold text-black dark:text-white">Page not found</h1>
      <p class="leading-7 text-black/70 dark:text-white/70">
        요청한 페이지를 찾을 수 없습니다. 주소를 확인하거나 홈으로 돌아가 주세요.
      </p>
      <a
        href="/"
        class="inline-flex w-fit rounded-full border border-black/15 px-4 py-2 text-sm text-black transition-colors hover:bg-black/[0.03] dark:border-white/20 dark:text-white dark:hover:bg-white/[0.06]"
      >
        Go home
      </a>
    </section>
  </BottomLayout>
</PageLayout>
