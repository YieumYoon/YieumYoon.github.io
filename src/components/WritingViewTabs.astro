---
type Props = {
  active: "all" | "english"
}

const { active } = Astro.props
const tabs = [
  { id: "all", label: "As written", href: "/blog/" },
  { id: "english", label: "English when available", href: "/blog/english/" },
] as const
---

<nav aria-label="Writing view" class="flex gap-5 border-b border-black/10 dark:border-white/15">
  {tabs.map((tab) => (
    <a
      href={tab.href}
      aria-current={active === tab.id ? "page" : undefined}
      class:list={[
        "-mb-px border-b py-3 text-sm transition-colors",
        active === tab.id
          ? "border-black font-semibold text-black dark:border-white dark:text-white"
          : "border-transparent text-black/55 hover:text-black dark:text-white/55 dark:hover:text-white",
      ]}
    >
      {tab.label}
    </a>
  ))}
</nav>
