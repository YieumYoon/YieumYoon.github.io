---
import { formatPostDateTime, getPostDateTime } from "@lib/utils"
import type { WritingViewItem } from "@lib/blog"

type Props = {
  item: WritingViewItem
  position?: number
  showStatus?: boolean
}

const { item, position = 1, showStatus = false } = Astro.props
const { source, display, path, status } = item
const analyticsId = source.data.slug ?? source.id.replace(/\/index$/, "")
const { date, time, timezone } = source.data
const statusLabel = status === "en-translation"
  ? "EN Translation"
  : status === "en-original"
    ? "EN Original"
    : "KO Original"
---

<a
  href={path}
  data-analytics-event="article_open"
  data-analytics-id={analyticsId}
  data-analytics-impression="article_impression"
  data-analytics-position={String(position)}
  class="group block py-5"
>
  <div class="grid gap-2 sm:grid-cols-[8rem_1fr] sm:gap-6">
    <time datetime={getPostDateTime({ date, time, timezone }).toISOString()} class="text-sm text-black/50 dark:text-white/50">
      {formatPostDateTime({ date, time, timezone })}
    </time>
    <div class="space-y-2" lang={display.data.lang}>
      {showStatus && (
        <p class="text-xs font-medium uppercase tracking-wide text-black/45 dark:text-white/45">
          {statusLabel}
        </p>
      )}
      <h2 class="font-semibold text-black dark:text-white group-hover:underline group-hover:decoration-[.5px] group-hover:underline-offset-4">
      {display.data.title}
      </h2>
      <p class="text-sm leading-6 text-black/65 dark:text-white/65 line-clamp-2">
        {display.data.summary}
      </p>
      <p class="text-xs uppercase text-black/45 dark:text-white/45">
        {display.data.tags.join(", ")}
      </p>
    </div>
  </div>
</a>
